# Jev classification. Set ONE of these.
#
# Preferred: Vercel AI Gateway. Routes TypeSafe's Jev model (typesafe-ai/jev).
AI_GATEWAY_API_KEY=

# Or the direct TypeSafe endpoint.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Reading saved posts needs no key. No key is ever committed: .env is gitignored.
